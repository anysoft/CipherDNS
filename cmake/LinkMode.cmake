if(CIPHERDNS_LINK STREQUAL "static" AND CMAKE_SYSTEM_NAME STREQUAL "Linux")
  set(_probe_dir "${CMAKE_BINARY_DIR}/CMakeFiles/cipherdns-static-probe")
  file(MAKE_DIRECTORY "${_probe_dir}")
  set(_probe_args)
  if(CMAKE_C_COMPILER_ARG1)
    separate_arguments(_compiler_args NATIVE_COMMAND "${CMAKE_C_COMPILER_ARG1}")
    list(APPEND _probe_args ${_compiler_args})
  endif()
  if(CMAKE_C_COMPILER_TARGET)
    list(APPEND _probe_args "--target=${CMAKE_C_COMPILER_TARGET}")
  endif()
  if(CMAKE_SYSROOT)
    list(APPEND _probe_args "--sysroot=${CMAKE_SYSROOT}")
  endif()
  separate_arguments(_probe_flags NATIVE_COMMAND "${CMAKE_C_FLAGS} ${CMAKE_EXE_LINKER_FLAGS}")
  execute_process(COMMAND "${CMAKE_C_COMPILER}" ${_probe_args} ${_probe_flags}
    -static "${CMAKE_CURRENT_SOURCE_DIR}/cmake/static-link-probe.c" -o "${_probe_dir}/probe"
    RESULT_VARIABLE _probe_result OUTPUT_VARIABLE _probe_out ERROR_VARIABLE _probe_err)
  if(NOT _probe_result EQUAL 0)
    message(FATAL_ERROR "Target static libc/startup objects unavailable. Use a complete target SDK; do not add host libraries.\n${_probe_out}${_probe_err}")
  endif()
endif()

function(cdns_link_executable target)
  if(NOT MSVC)
    if(APPLE)
      target_link_options(${target} PRIVATE -Wl,-dead_strip)
    else()
      target_link_options(${target} PRIVATE -Wl,--gc-sections)
    endif()
    if(CIPHERDNS_LINK STREQUAL "static")
      target_link_options(${target} PRIVATE -static)
    endif()
    if(CIPHERDNS_LINK STREQUAL "mostly-static" OR CIPHERDNS_LINK STREQUAL "static")
      if(CMAKE_C_COMPILER_ID STREQUAL "GNU")
        target_link_options(${target} PRIVATE -static-libgcc)
      endif()
    endif()
  endif()
endfunction()

function(cdns_verify_binary target)
  set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/cmake/VerifyBinary.cmake")
  find_program(_file_tool NAMES file)
  if(NOT CMAKE_READELF)
    find_program(CMAKE_READELF NAMES readelf llvm-readelf)
  endif()
  if(NOT CMAKE_OBJDUMP)
    find_program(CMAKE_OBJDUMP NAMES objdump llvm-objdump)
  endif()
  find_program(_otool_tool NAMES otool)
  find_program(_lipo_tool NAMES lipo)
  find_program(_dumpbin_tool NAMES dumpbin)
  set(_verify_libc "${CIPHERDNS_LIBC}")
  set(_verify_triplet "${CMAKE_C_COMPILER_TARGET}")
  if(NOT MSVC)
    set(_compiler_args)
    if(CMAKE_C_COMPILER_ARG1)
      separate_arguments(_compiler_args NATIVE_COMMAND "${CMAKE_C_COMPILER_ARG1}")
    endif()
    if(CMAKE_C_COMPILER_TARGET)
      list(APPEND _compiler_args "--target=${CMAKE_C_COMPILER_TARGET}")
    endif()
    if(APPLE AND CMAKE_OSX_ARCHITECTURES)
      list(LENGTH CMAKE_OSX_ARCHITECTURES _compiler_arch_count)
      if(_compiler_arch_count EQUAL 1)
        list(APPEND _compiler_args -arch "${CMAKE_OSX_ARCHITECTURES}")
      endif()
    endif()
    execute_process(COMMAND "${CMAKE_C_COMPILER}" ${_compiler_args} -dumpmachine
      OUTPUT_VARIABLE _verify_triplet OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  else()
    set(_verify_triplet "MSVC-${CMAKE_C_COMPILER_ARCHITECTURE_ID}")
  endif()
  if(_verify_libc STREQUAL "auto")
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
      set(_verify_libc platform)
    elseif(_verify_triplet MATCHES "musl")
      set(_verify_libc musl)
    elseif(_verify_triplet MATCHES "uclibc")
      set(_verify_libc uClibc)
    elseif(NOT MSVC)
      set(_libc_probe "${CMAKE_BINARY_DIR}/CMakeFiles/cipherdns-libc-probe.c")
      file(WRITE "${_libc_probe}" "#include <features.h>\n")
      set(_libc_args ${_compiler_args})
      if(CMAKE_SYSROOT)
        list(APPEND _libc_args "--sysroot=${CMAKE_SYSROOT}")
      endif()
      separate_arguments(_libc_flags NATIVE_COMMAND "${CMAKE_C_FLAGS}")
      execute_process(COMMAND "${CMAKE_C_COMPILER}" ${_libc_args} ${_libc_flags} -dM -E "${_libc_probe}"
        OUTPUT_VARIABLE _libc_macros RESULT_VARIABLE _libc_rc ERROR_QUIET)
      if(_libc_rc EQUAL 0 AND _libc_macros MATCHES "__UCLIBC__")
        set(_verify_libc uClibc)
      elseif(_libc_rc EQUAL 0 AND _libc_macros MATCHES "__GLIBC__")
        set(_verify_libc glibc)
      else()
        set(_verify_libc "unknown; set CIPHERDNS_LIBC using the actual SDK")
      endif()
    endif()
  endif()
  set(_verify_processor "${CMAKE_SYSTEM_PROCESSOR}")
  if(APPLE AND CMAKE_OSX_ARCHITECTURES)
    list(LENGTH CMAKE_OSX_ARCHITECTURES _arch_count)
    if(_arch_count EQUAL 1)
      set(_verify_processor "${CMAKE_OSX_ARCHITECTURES}")
    endif()
  endif()
  add_custom_command(TARGET ${target} POST_BUILD
    COMMAND "${CMAKE_COMMAND}" "-DBINARY=$<TARGET_FILE:${target}>"
      "-DREPORT=$<TARGET_FILE:${target}>.link-report.txt"
      "-DMODE=${CIPHERDNS_LINK}" "-DSYSTEM=${CMAKE_SYSTEM_NAME}"
      "-DPROCESSOR=${_verify_processor}" "-DCOMPILER=${CMAKE_C_COMPILER}"
      "-DCOMPILER_VERSION=${CMAKE_C_COMPILER_VERSION}" "-DSYSROOT=${CMAKE_SYSROOT}"
      "-DLIBC=${_verify_libc}" "-DTRIPLET=${_verify_triplet}"
      "-DMIN_KERNEL=${CIPHERDNS_MIN_KERNEL}" "-DVERSION=${CIPHERDNS_VERSION}"
      "-DBUILD_MODE=${CIPHERDNS_MODE}"
      "-DFILE_TOOL=${_file_tool}" "-DREADELF_TOOL=${CMAKE_READELF}"
      "-DOBJDUMP_TOOL=${CMAKE_OBJDUMP}" "-DOTOOL_TOOL=${_otool_tool}"
      "-DLIPO_TOOL=${_lipo_tool}"
      "-DDUMPBIN_TOOL=${_dumpbin_tool}"
      -P "${CMAKE_CURRENT_SOURCE_DIR}/cmake/VerifyBinary.cmake"
    VERBATIM)
endfunction()
