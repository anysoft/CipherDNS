if(NOT EXISTS "${BINARY}")
  message(FATAL_ERROR "Binary missing: ${BINARY}")
endif()
file(SIZE "${BINARY}" _bytes)
file(SHA256 "${BINARY}" _sha256)
file(WRITE "${REPORT}" "version: ${VERSION}\nbuild_mode: ${BUILD_MODE}\nsize_bytes: ${_bytes}\nsha256: ${_sha256}\nsystem: ${SYSTEM}\nprocessor: ${PROCESSOR}\nlibc: ${LIBC}\nlink_mode: ${MODE}\ncompiler: ${COMPILER} ${COMPILER_VERSION}\ncompiler_target: ${TRIPLET}\nsysroot: ${SYSROOT}\n")
function(inspect out tool)
  if(NOT tool OR tool MATCHES "-NOTFOUND$")
    message(FATAL_ERROR "Required binary inspection tool unavailable: ${tool}")
  endif()
  execute_process(COMMAND "${tool}" ${ARGN} "${BINARY}" RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  file(APPEND "${REPORT}" "\n${tool} ${ARGN}:\n${_out}${_err}")
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "Binary inspection failed; see ${REPORT}")
  endif()
  set(${out} "${_out}" PARENT_SCOPE)
endfunction()
if(FILE_TOOL AND NOT FILE_TOOL MATCHES "-NOTFOUND$")
  inspect(_file "${FILE_TOOL}")
endif()
if(SYSTEM STREQUAL "Linux")
  inspect(_header "${READELF_TOOL}" -W -h)
  inspect(_program "${READELF_TOOL}" -W -l)
  inspect(_deps "${READELF_TOOL}" -W -d)
  inspect(_versions "${READELF_TOOL}" -W --version-info)
  inspect(_attributes "${READELF_TOOL}" -W -A)
  inspect(_notes "${READELF_TOOL}" -W -n)
  if(MODE STREQUAL "static" AND (_program MATCHES "[ \t]INTERP[ \t]" OR _deps MATCHES "NEEDED"))
    message(FATAL_ERROR "Static ELF contains interpreter or NEEDED dependency; see ${REPORT}")
  endif()
  if(PROCESSOR MATCHES "^(x86_64|amd64)$" AND NOT _header MATCHES "X86-64")
    message(FATAL_ERROR "ELF architecture is not x86_64")
  elseif(PROCESSOR MATCHES "^(i.86|x86)$" AND NOT _header MATCHES "80386")
    message(FATAL_ERROR "ELF architecture is not i686")
  elseif(PROCESSOR MATCHES "^(aarch64|arm64)$" AND NOT _header MATCHES "AArch64")
    message(FATAL_ERROR "ELF architecture is not AArch64")
  elseif(PROCESSOR MATCHES "^armv[57]" AND NOT _header MATCHES "ARM")
    message(FATAL_ERROR "ELF architecture is not ARM")
  elseif(PROCESSOR MATCHES "^mips" AND NOT _header MATCHES "MIPS")
    message(FATAL_ERROR "ELF architecture is not MIPS")
  endif()
  if(PROCESSOR STREQUAL "mipsel" AND NOT _header MATCHES "little endian")
    message(FATAL_ERROR "MIPSEL output has wrong endianness")
  elseif(PROCESSOR STREQUAL "mips" AND NOT _header MATCHES "big endian")
    message(FATAL_ERROR "MIPS output has wrong endianness")
  endif()
  if(PROCESSOR STREQUAL "armv5")
    if(_attributes MATCHES "Tag_CPU_arch: v([6-9]|[1-9][0-9])" OR
       _attributes MATCHES "Tag_ABI_VFP_args: VFP registers" OR _header MATCHES "hard-float ABI")
      message(FATAL_ERROR "ARMv5 soft-float output contains newer CPU or hard-float attributes; verify target SDK libc")
    endif()
    if(NOT _attributes MATCHES "Tag_CPU_arch: v5" AND NOT _attributes MATCHES "Description: ARM v5")
      message(FATAL_ERROR "ARMv5 CPU attribute could not be verified; require an SDK declaring ARMv5 ISA")
    endif()
  elseif(PROCESSOR STREQUAL "armv7")
    if(_attributes MATCHES "Tag_CPU_arch: v([8-9]|[1-9][0-9])")
      message(FATAL_ERROR "ARMv7 output requires a newer CPU ISA; verify target SDK")
    endif()
    if(NOT _attributes MATCHES "Tag_ABI_VFP_args: VFP registers" AND NOT _header MATCHES "hard-float ABI")
      message(FATAL_ERROR "ARMv7 hard-float output lacks hard-float ABI attributes")
    endif()
  endif()
  string(REGEX MATCH "Data:[^\n]*" _endian "${_header}")
  string(REGEX MATCH "Flags:[^\n]*" _abi "${_header}")
  string(REGEX MATCH "Requesting program interpreter: ([^]]+)" _interpreter "${_program}")
  if(_interpreter)
    set(_interpreter "${CMAKE_MATCH_1}")
  else()
    set(_interpreter none)
  endif()
  string(REGEX MATCHALL "GLIBC_[0-9]+\\.[0-9]+(\\.[0-9]+)?" _glibc_versions "${_versions}")
  if(_glibc_versions)
    list(REMOVE_DUPLICATES _glibc_versions)
    list(SORT _glibc_versions COMPARE NATURAL ORDER DESCENDING)
    list(GET _glibc_versions 0 _glibc_min)
  else()
    set(_glibc_min "none recorded; not proof of device compatibility")
  endif()
  file(APPEND "${REPORT}" "\nbyte_order: ${_endian}\nabi_flags: ${_abi}\nelf_interpreter: ${_interpreter}\nminimum_glibc_symbol_version: ${_glibc_min}\nminimum_kernel: ${MIN_KERNEL}\ncompatibility: CPU/ABI, kernel, resolver and firmware runtime require device acceptance\n")
elseif(SYSTEM STREQUAL "Darwin")
  inspect(_archs "${LIPO_TOOL}" -archs)
  if(NOT _archs MATCHES "(^|[ \n])${PROCESSOR}([ \n]|$)")
    message(FATAL_ERROR "Mach-O output is missing expected architecture ${PROCESSOR}")
  endif()
  inspect(_deps "${OTOOL_TOOL}" -L)
  inspect(_load "${OTOOL_TOOL}" -l)
  file(APPEND "${REPORT}" "\nbyte_order: little endian\nabi: Mach-O ${PROCESSOR}\nelf_interpreter: not applicable\nminimum_os: see LC_BUILD_VERSION/LC_VERSION_MIN_MACOSX above\ncompatibility: requires system libSystem/resolver and recorded minimum macOS\n")
elseif(SYSTEM STREQUAL "Windows")
  if(DUMPBIN_TOOL AND NOT DUMPBIN_TOOL MATCHES "-NOTFOUND$")
    inspect(_deps "${DUMPBIN_TOOL}" /dependents)
    inspect(_header "${DUMPBIN_TOOL}" /headers)
  else()
    inspect(_deps "${OBJDUMP_TOOL}" -p)
    inspect(_header "${OBJDUMP_TOOL}" -f)
  endif()
  file(APPEND "${REPORT}" "\nbyte_order: little endian\nabi: PE ${PROCESSOR}\nelf_interpreter: not applicable\nminimum_os: Windows 8 API floor; imported system DLLs and target Windows still need runtime acceptance\n")
  string(TOLOWER "${_header}" _pe_header)
  if(PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$" AND NOT _pe_header MATCHES "x86-64|x86_64|8664 machine|machine.*x64")
    message(FATAL_ERROR "PE output is not x86_64")
  elseif(PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$" AND NOT _pe_header MATCHES "aarch64|arm64|aa64 machine")
    message(FATAL_ERROR "PE output is not ARM64")
  endif()
else()
  message(FATAL_ERROR "Binary inspection not implemented for ${SYSTEM}")
endif()
string(TOLOWER "${_deps}" _lower_deps)
if(_lower_deps MATCHES "libmbed(tls|crypto|x509)|libssl|libcrypto|libcurl")
  message(FATAL_ERROR "Unexpected third-party shared dependency; see ${REPORT}")
endif()
if(SYSTEM STREQUAL "Windows" AND NOT MODE STREQUAL "dynamic" AND
   _lower_deps MATCHES "libgcc_s|libwinpthread|vcruntime[0-9]*\\.dll|msvcp[0-9]*\\.dll")
  message(FATAL_ERROR "Unexpected compiler runtime DLL; see ${REPORT}")
endif()
file(APPEND "${REPORT}" "\nverification: PASS\n")
message(STATUS "Verified binary: ${REPORT}")
