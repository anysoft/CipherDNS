# Use one GCC SDK and its sysroot; never add host include/library directories.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
foreach(_cdns_env CPATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH OBJC_INCLUDE_PATH LIBRARY_PATH GCC_EXEC_PREFIX COMPILER_PATH)
  if(NOT "$ENV{${_cdns_env}}" STREQUAL "")
    message(FATAL_ERROR "Unset ${_cdns_env}: implicit host search paths are forbidden in SDK builds")
  endif()
endforeach()
set(_cdns_root "$ENV{CIPHERDNS_TOOLCHAIN_ROOT}")
set(_cdns_prefix "$ENV{CIPHERDNS_CROSS_PREFIX}")
set(_cdns_compiler "$ENV{CIPHERDNS_C_COMPILER}")
if(NOT _cdns_root STREQUAL "")
  get_filename_component(_cdns_root "${_cdns_root}" ABSOLUTE)
  if(NOT IS_DIRECTORY "${_cdns_root}/bin" OR _cdns_root STREQUAL "/")
    message(FATAL_ERROR "CIPHERDNS_TOOLCHAIN_ROOT must be an SDK root containing bin/")
  endif()
  if(_cdns_compiler STREQUAL "" AND _cdns_prefix STREQUAL "")
    # Buildroot may expose several aliases of one compiler. Canonicalize first.
    file(GLOB _cdns_candidates "${_cdns_root}/bin/*-gcc")
    set(_cdns_gcc)
    foreach(_candidate IN LISTS _cdns_candidates)
      if(EXISTS "${_candidate}.br_real")
        # Buildroot uses a common wrapper even for distinct GCC installations.
        get_filename_component(_real "${_candidate}.br_real" REALPATH)
      else()
        get_filename_component(_real "${_candidate}" REALPATH)
      endif()
      list(APPEND _cdns_gcc "${_real}")
    endforeach()
    list(REMOVE_DUPLICATES _cdns_gcc)
    list(LENGTH _cdns_gcc _cdns_count)
    if(NOT _cdns_count EQUAL 1)
      message(FATAL_ERROR "Expected one SDK GCC; set CIPHERDNS_CROSS_PREFIX or CIPHERDNS_C_COMPILER to select explicitly")
    endif()
    # Keep the SDK alias: Buildroot wrappers may dispatch using argv[0].
    list(GET _cdns_candidates 0 _cdns_compiler)
  elseif(_cdns_compiler STREQUAL "")
    string(REGEX REPLACE "-+$" "" _cdns_prefix "${_cdns_prefix}")
    if(IS_ABSOLUTE "${_cdns_prefix}")
      set(_cdns_compiler "${_cdns_prefix}-gcc")
    else()
      set(_cdns_compiler "${_cdns_root}/bin/${_cdns_prefix}-gcc")
    endif()
  elseif(NOT IS_ABSOLUTE "${_cdns_compiler}")
    set(_cdns_compiler "${_cdns_root}/bin/${_cdns_compiler}")
  endif()
  get_filename_component(_cdns_compiler_dir "${_cdns_compiler}" DIRECTORY)
  get_filename_component(_cdns_compiler_dir "${_cdns_compiler_dir}" REALPATH)
  get_filename_component(_cdns_sdk_bin "${_cdns_root}/bin" REALPATH)
  if(NOT _cdns_compiler_dir STREQUAL _cdns_sdk_bin)
    message(FATAL_ERROR "The selected GCC must be in CIPHERDNS_TOOLCHAIN_ROOT/bin")
  endif()
else()
  if(_cdns_prefix STREQUAL "")
    set(_cdns_prefix "${CDNS_DEFAULT_PREFIX}")
  endif()
  string(REGEX REPLACE "-+$" "" _cdns_prefix "${_cdns_prefix}")
  if(_cdns_compiler STREQUAL "")
    set(_cdns_compiler "${_cdns_prefix}-gcc")
  endif()
  unset(_cdns_gcc_path CACHE)
  unset(_cdns_gcc_path)
  find_program(_cdns_gcc_path NAMES "${_cdns_compiler}" REQUIRED)
  set(_cdns_compiler "${_cdns_gcc_path}")
endif()
if(NOT EXISTS "${_cdns_compiler}")
  message(FATAL_ERROR "Target GCC not found: ${_cdns_compiler}")
endif()
set(CMAKE_C_COMPILER "${_cdns_compiler}")
execute_process(COMMAND "${CMAKE_C_COMPILER}" -dumpmachine RESULT_VARIABLE _cdns_rc
  OUTPUT_VARIABLE _cdns_triplet ERROR_VARIABLE _cdns_error OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT _cdns_rc EQUAL 0 OR _cdns_triplet STREQUAL "")
  message(FATAL_ERROR "Target GCC cannot execute on this build host (${_cdns_rc}); use a host-compatible SDK. ${_cdns_error}")
endif()
if(CMAKE_SYSTEM_PROCESSOR MATCHES "^armv[57]" AND NOT _cdns_triplet MATCHES "^arm.*linux")
  message(FATAL_ERROR "ARM Linux target requires an ARM Linux GCC SDK, got ${_cdns_triplet}")
endif()
if(CMAKE_SYSTEM_PROCESSOR STREQUAL "armv5" AND _cdns_triplet MATCHES "hf$")
  message(FATAL_ERROR "ARMv5 requires soft-float gnueabi/musleabi; hard-float SDK selected")
endif()
get_filename_component(_cdns_bin "${CMAKE_C_COMPILER}" DIRECTORY)
get_filename_component(_cdns_gcc_name "${CMAKE_C_COMPILER}" NAME)
string(REGEX REPLACE "gcc(-[0-9.]+)?$" "" _cdns_tool_prefix "${_cdns_gcc_name}")
foreach(_tool AR RANLIB STRIP READELF OBJDUMP NM SIZE)
  string(TOLOWER "${_tool}" _tool_name)
  # Never retain a previous SDK's find_program results when reconfiguring.
  unset(_cdns_${_tool} CACHE)
  unset(_cdns_${_tool})
  if(NOT _cdns_root STREQUAL "")
    find_program(_cdns_${_tool} NAMES "${_cdns_tool_prefix}${_tool_name}"
      PATHS "${_cdns_root}/bin" NO_DEFAULT_PATH REQUIRED)
  else()
    find_program(_cdns_${_tool} NAMES "${_cdns_tool_prefix}${_tool_name}"
      HINTS "${_cdns_bin}" REQUIRED)
  endif()
  set(CMAKE_${_tool} "${_cdns_${_tool}}")
endforeach()
if(NOT "$ENV{CIPHERDNS_SYSROOT}" STREQUAL "")
  set(_cdns_sysroot "$ENV{CIPHERDNS_SYSROOT}")
else()
  execute_process(COMMAND "${CMAKE_C_COMPILER}" -print-sysroot RESULT_VARIABLE _cdns_rc
    OUTPUT_VARIABLE _cdns_sysroot OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT _cdns_rc EQUAL 0)
    message(FATAL_ERROR "Cannot determine target GCC sysroot")
  endif()
endif()
if(_cdns_sysroot AND NOT _cdns_sysroot STREQUAL "/")
  if(NOT IS_DIRECTORY "${_cdns_sysroot}")
    message(FATAL_ERROR "Target sysroot is missing; relocate the SDK using its relocation script")
  endif()
  get_filename_component(CMAKE_SYSROOT "${_cdns_sysroot}" REALPATH)
  if(NOT _cdns_root STREQUAL "")
    get_filename_component(_cdns_root_real "${_cdns_root}" REALPATH)
    string(FIND "${CMAKE_SYSROOT}/" "${_cdns_root_real}/" _cdns_root_prefix)
    if(NOT _cdns_root_prefix EQUAL 0)
      message(FATAL_ERROR "SDK sysroot must belong to CIPHERDNS_TOOLCHAIN_ROOT; host/external libraries are forbidden")
    endif()
  endif()
  set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
elseif(_cdns_root STREQUAL "" AND IS_DIRECTORY "/usr/${_cdns_triplet}")
  # Ubuntu GCC uses / internally and keeps target files under /usr/<triplet>.
  set(CMAKE_FIND_ROOT_PATH "/usr/${_cdns_triplet}")
else()
  message(FATAL_ERROR "A real target sysroot is required; set CIPHERDNS_SYSROOT. Host / is forbidden")
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
