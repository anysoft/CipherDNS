# Pinned Zig is an optional build tool, never a target/runtime dependency.
# ARMv5 intentionally uses GCC/Buildroot instead.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES CMAKE_READELF CMAKE_OBJDUMP)
if("$ENV{CIPHERDNS_ZIG}" STREQUAL "" OR "$ENV{CIPHERDNS_ZIG_TARGET}" STREQUAL "" OR "$ENV{CIPHERDNS_ARCH}" STREQUAL "")
  message(FATAL_ERROR "Set CIPHERDNS_ZIG, CIPHERDNS_ZIG_TARGET and CIPHERDNS_ARCH")
endif()
set(CMAKE_SYSTEM_PROCESSOR "$ENV{CIPHERDNS_ARCH}")
if(CMAKE_SYSTEM_PROCESSOR STREQUAL "armv5")
  message(FATAL_ERROR "Use the ARMv5 GCC/Buildroot SDK toolchain")
endif()
set(CMAKE_C_COMPILER "$ENV{CIPHERDNS_ZIG}")
set(CMAKE_C_COMPILER_ARG1 "cc -target $ENV{CIPHERDNS_ZIG_TARGET}")
set(CMAKE_C_FLAGS_INIT "$ENV{CIPHERDNS_ARCH_FLAGS}")
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/CMakeFiles/cipherdns-zig-tools")
foreach(_tool ar ranlib)
  set(_path "${CMAKE_BINARY_DIR}/CMakeFiles/cipherdns-zig-tools/zig-${_tool}")
  file(WRITE "${_path}" "#!/bin/sh\nexec \"$ENV{CIPHERDNS_ZIG}\" ${_tool} \"$@\"\n")
  file(CHMOD "${_path}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
  string(TOUPPER "${_tool}" _upper)
  set(CMAKE_${_upper} "${_path}")
endforeach()
find_program(CMAKE_READELF NAMES readelf llvm-readelf REQUIRED)
find_program(CMAKE_OBJDUMP NAMES objdump llvm-objdump REQUIRED)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
