# Supply CIPHERDNS_TOOLCHAIN_ROOT (or CROSS_PREFIX), SYSROOT and CIPHERDNS_ARCH.
set(CMAKE_SYSTEM_PROCESSOR "$ENV{CIPHERDNS_ARCH}")
if(CMAKE_SYSTEM_PROCESSOR STREQUAL "")
  message(FATAL_ERROR "sdk-linux.cmake requires the actual CIPHERDNS_ARCH")
endif()
set(CMAKE_C_FLAGS_INIT "$ENV{CIPHERDNS_ARCH_FLAGS}")
if("$ENV{CIPHERDNS_CROSS_PREFIX}" STREQUAL "" AND "$ENV{CIPHERDNS_TOOLCHAIN_ROOT}" STREQUAL "")
  message(FATAL_ERROR "sdk-linux.cmake requires CIPHERDNS_TOOLCHAIN_ROOT or CIPHERDNS_CROSS_PREFIX")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/_linux-common.cmake")
