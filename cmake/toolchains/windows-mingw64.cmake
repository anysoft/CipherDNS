set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(_cdns_prefix "$ENV{CIPHERDNS_CROSS_PREFIX}")
if(_cdns_prefix STREQUAL "")
  set(_cdns_prefix x86_64-w64-mingw32-)
endif()
set(CMAKE_C_COMPILER "${_cdns_prefix}gcc")
set(CMAKE_AR "${_cdns_prefix}ar")
set(CMAKE_RANLIB "${_cdns_prefix}ranlib")
set(CMAKE_STRIP "${_cdns_prefix}strip")
set(CMAKE_OBJDUMP "${_cdns_prefix}objdump")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
