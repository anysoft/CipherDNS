# Supply the SDK staging_dir/toolchain-*/ as CIPHERDNS_TOOLCHAIN_ROOT.
# Select exact target/ABI using CIPHERDNS_ARCH and CIPHERDNS_ARCH_FLAGS.
if("$ENV{CIPHERDNS_TOOLCHAIN_ROOT}" STREQUAL "" OR "$ENV{CIPHERDNS_ARCH}" STREQUAL "")
  message(FATAL_ERROR "OpenWrt requires CIPHERDNS_TOOLCHAIN_ROOT and CIPHERDNS_ARCH")
endif()
set(CMAKE_SYSTEM_PROCESSOR "$ENV{CIPHERDNS_ARCH}")
set(CMAKE_C_FLAGS_INIT "$ENV{CIPHERDNS_ARCH_FLAGS}")
include("${CMAKE_CURRENT_LIST_DIR}/_linux-common.cmake")
